#!/usr/bin/env python3
"""Debugger shim (Claude lane): orchestrator payload -> debugger-response JSON.

Input  (stdin):  {"role":"debugger","goal":...,"task":{...},"artifact":{...},"result":{...}}
Output (stdout): {"feedback": "<focused fix guidance>"}

Provider command env var: MAO_CLAUDE_CMD
"""
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from _shim import emit, extract_json, read_payload, require, run_provider

PROMPT = """You are the DEBUGGER in a Claude+Codex orchestration loop. The generated
code failed. Read the exact error and give ONE focused instruction the coder can
act on next. Do not rewrite the file; describe the fix.

Goal:
{goal}

Task:
{task}

Artifact:
{artifact}

Execution result (stdout/stderr/exit_code):
{result}

Return ONLY a JSON object, no prose, exactly this shape:
{{"feedback": "<one focused, actionable instruction>"}}"""


def main() -> None:
    payload = read_payload()
    raw = run_provider(
        "MAO_CLAUDE_CMD",
        PROMPT.format(
            goal=str(payload.get("goal", "")),
            task=json.dumps(payload.get("task", {}), indent=2),
            artifact=json.dumps(payload.get("artifact", {}), indent=2),
            result=json.dumps(payload.get("result", {}), indent=2),
        ),
    )
    data = extract_json(raw)
    require(data, ["feedback"], "debugger")
    emit({"feedback": str(data["feedback"])})


if __name__ == "__main__":
    main()
