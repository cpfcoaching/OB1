{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Coder response",
  "type": "object",
  "required": ["file_name", "content", "command"],
  "properties": {
    "file_name": { "type": "string" },
    "content": { "type": "string" },
    "command": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    }
  },
  "additionalProperties": false
}
